# SingSlot Docker Compose Environment Variables (Example Placeholders)
# Copy this file to `.env` at the repository root before running `docker compose up`.
# Never commit real passwords, JWT secrets, or production credentials.

POSTGRES_USER=singslot
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=singslot

JWT_SECRET=replace-with-32-plus-char-random-jwt-secret
STAFF_PASSWORD=replace-with-demo-staff-password
CUSTOMER_PASSWORD=replace-with-demo-customer-password
