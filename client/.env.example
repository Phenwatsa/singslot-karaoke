# SingSlot Client Environment Variables (Twelve-Factor R-02)

# Demo quick-fill passwords for local development testing (Sprint 1 seeded accounts)
# Only rendered and evaluated when running in development mode (import.meta.env.DEV)
# Matches STAFF_PASSWORD and CUSTOMER_PASSWORD configured in server/.env
VITE_STAFF_DEMO_PASSWORD=replace_with_demo_staff_password
VITE_CUSTOMER_DEMO_PASSWORD=replace_with_demo_customer_password

# Optional fallback if both roles share identical development credentials
VITE_DEMO_PASSWORD=replace_with_demo_password

