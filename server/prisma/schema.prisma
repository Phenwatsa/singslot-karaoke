datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  STAFF
}

enum RoomType {
  SMALL
  MEDIUM
  LARGE
}

enum BookingChannel {
  ONLINE
  WALK_IN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  bookings     Booking[]

  @@map("users")
}

model Room {
  id           String        @id @default(uuid())
  roomNumber   String        @unique
  type         RoomType
  capacity     Int
  description  String?
  isActive     Boolean       @default(true)
  bookings     Booking[]
  bookingSlots BookingSlot[]
  blocks       RoomBlock[]

  @@map("rooms")
}

model Booking {
  id            String         @id @default(uuid())
  bookingCode   String         @unique
  userId        String
  roomId        String
  bookingDate   String         // Format: YYYY-MM-DD (Asia/Bangkok timezone)
  startSlot     Int            // 0..13 (0 = 10:00-11:00)
  durationHours Int            // 1..5
  partySize     Int
  channel       BookingChannel @default(ONLINE)
  customerName  String
  customerPhone String?
  status        BookingStatus  @default(CONFIRMED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  slots         BookingSlot[]

  @@index([bookingDate])
  @@index([userId])
  @@index([roomId])
  @@map("bookings")
}

model BookingSlot {
  id          String   @id @default(uuid())
  bookingId   String
  roomId      String
  bookingDate String   // Format: YYYY-MM-DD
  slotIndex   Int      // 0..13

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  // Composite unique constraint: exactly one active booking slot per room-date-slot
  @@unique([roomId, bookingDate, slotIndex])
  @@index([bookingDate])
  @@map("booking_slots")
}

model RoomBlock {
  id        String   @id @default(uuid())
  roomId    String
  blockDate String   // Format: YYYY-MM-DD
  slotIndex Int      // 0..13
  reason    String?
  createdAt DateTime @default(now())

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Composite unique constraint: exactly one block per room-date-slot
  @@unique([roomId, blockDate, slotIndex])
  @@index([blockDate])
  @@map("room_blocks")
}
