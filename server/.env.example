# Local Development Port (Matches client Vite proxy http://localhost:5001)
# In production, Google Cloud Run automatically injects PORT=8080
PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/singslot_dev?schema=public

# Cryptographic JWT Secret
# IMPORTANT: Developers MUST configure a unique, cryptographically random secret before running the server.
# Generate a secure 256-bit secret using: openssl rand -base64 32
# The server implements fail-fast validation and will abort startup if this variable is missing or empty.
JWT_SECRET=replace_with_openssl_rand_base64_32

# Seed Demo Credentials (Twelve-Factor R-02 / R-12)
# In production, STAFF_PASSWORD is mounted securely via Secret Manager (singslot-staff-password)
# into the singslot-migrate Cloud Run job and omitted from runtime service.
STAFF_PASSWORD=replace_with_demo_staff_password
CUSTOMER_PASSWORD=replace_with_demo_customer_password

# Static Client Distribution Path (Optional, for single-origin production container serving)
# Defaults to ../../client/dist relative to server dist directory
CLIENT_DIST_PATH=
